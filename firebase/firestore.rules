rules_version = '2';

// Data model: src/backend/model.ts. Tests: firebase/tests/rules.test.mjs (`npm run test:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function usernamePath(name) {
      return /databases/$(database)/documents/usernames/$(name);
    }

    function isNullableString(v, maxLen) {
      return v == null || (v is string && v.size() <= maxLen);
    }

    // YYYY-MM-DD and at least 18 years old (account holders are adults).
    function isAdultBirthdate(b) {
      return b is string
        && b.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.time >= timestamp.date(
             int(b.split('-')[0]) + 18, int(b.split('-')[1]), int(b.split('-')[2]));
    }

    function validPreferences(p) {
      return p is map
        && p.keys().hasOnly(['darkMode', 'activeContextId', 'communityFilter'])
        && (!('darkMode' in p) || p.darkMode == null || p.darkMode is bool)
        && (!('activeContextId' in p) || isNullableString(p.activeContextId, 100))
        && (!('communityFilter' in p) || p.communityFilter == null
            || p.communityFilter in ['all', 'vetted', 'friends']);
    }

    // Username fields are both null, or the lowercase form is claimed by this user.
    function validUsername(data, uid) {
      return (data.username == null && data.usernameLower == null)
        || (data.username is string
            && data.usernameLower == data.username.lower()
            && data.usernameLower.matches('^[a-z0-9_.]{3,20}$')
            && existsAfter(usernamePath(data.usernameLower))
            && getAfter(usernamePath(data.usernameLower)).data.uid == uid);
    }

    // Display name: free text up to 40 characters, not blank once set. The adult
    // confirmation is a timestamp set by the server clock when the profile is saved.
    function validDisplayName(name) {
      return name == null
        || (name is string && name.size() >= 1 && name.size() <= 40 && name.trim().size() >= 1);
    }

    function validAgeConfirmedAt(v) {
      return v == null || v is timestamp;
    }

    function validProfileFields(data, uid) {
      return validUsername(data, uid)
        && validDisplayName(data.get('displayName', null))
        && validAgeConfirmedAt(data.get('ageConfirmedAt', null))
        && (data.birthdate == null || isAdultBirthdate(data.birthdate))
        && isNullableString(data.photoUrl, 2048)
        && validPreferences(data.preferences)
        && data.updatedAt == request.time;
    }

    // ---------- users/{uid}: the account ----------
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'schemaVersion', 'displayName', 'ageConfirmedAt', 'username', 'usernameLower',
             'email', 'authProvider', 'birthdate', 'photoUrl', 'plan', 'preferences',
             'createdAt', 'updatedAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.authProvider in ['apple', 'google', 'email']
        && request.resource.data.email == request.auth.token.get('email', null)
        // Plans are granted by the server after a verified purchase, never by the client.
        && request.resource.data.plan == 'free'
        && request.resource.data.createdAt == request.time
        && validProfileFields(request.resource.data, uid);

      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'displayName', 'ageConfirmedAt', 'username', 'usernameLower', 'birthdate',
             'photoUrl', 'preferences', 'updatedAt'])
        && validProfileFields(request.resource.data, uid);

      // Account deletion: the app deletes the subcollections first, then this document
      // (with the username claim) in one batch, then the sign-in itself.
      allow delete: if isOwner(uid);

      // ---------- user-owned data synced from the device ----------
      match /contexts/{contextId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
               'label', 'ageGroupDefault', 'isAnonymous', 'colorToken',
               'createdAt', 'archivedAt', 'updatedAt'])
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 60
          && (request.resource.data.ageGroupDefault == null
              || request.resource.data.ageGroupDefault in ['3-5', '6-8', '9-12', '13-15'])
          && request.resource.data.isAnonymous is bool
          && request.resource.data.createdAt is timestamp;
      }

      match /favorites/{favoriteId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['contextId', 'promptId', 'favoritedAt'])
          && favoriteId == request.resource.data.contextId + '__' + request.resource.data.promptId
          && request.resource.data.favoritedAt is timestamp;
      }

      match /reflections/{reflectionId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
               'contextId', 'promptId', 'note', 'rating', 'createdAt'])
          && request.resource.data.contextId is string
          && request.resource.data.promptId is string
          && isNullableString(request.resource.data.note, 5000)
          && (request.resource.data.rating == null
              || (request.resource.data.rating is int
                  && request.resource.data.rating >= 1
                  && request.resource.data.rating <= 5))
          && request.resource.data.createdAt is timestamp;
      }

      // Prompts the user wrote. Deleting one sets `deleted` (other devices may still
      // have favorites or notes pointing at it); the document itself goes only when the
      // whole account is deleted.
      match /myPrompts/{promptId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && promptId.matches('^user-[a-z0-9-]{1,40}$')
          && request.resource.data.keys().hasOnly([
               'text', 'ageGroup', 'situations', 'deleted', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll([
               'text', 'ageGroup', 'situations', 'deleted', 'createdAt', 'updatedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.ageGroup in ['3-5', '6-8', '9-12', '13-15']
          && request.resource.data.situations is list
          && request.resource.data.situations.size() <= 10
          && request.resource.data.deleted is bool
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
      }

      match /moduleProgress/{progressId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['contextId', 'moduleId', 'promptId', 'completedAt'])
          && progressId == request.resource.data.contextId + '__'
               + request.resource.data.moduleId + '__' + request.resource.data.promptId;
      }
    }

    // ---------- reports/{id}: prompt reports from the flag icon ----------
    // Anyone can file one (accounts are optional); nobody can read or change them from
    // the app. The team reviews them in the Firebase console. No personal data.
    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly(
            ['promptId', 'reason', 'appVersion', 'platform', 'uid', 'createdAt'])
        && request.resource.data.keys().hasAll(
            ['promptId', 'reason', 'appVersion', 'platform', 'uid', 'createdAt'])
        && request.resource.data.promptId is string
        && request.resource.data.promptId.size() > 0
        && request.resource.data.promptId.size() <= 100
        && request.resource.data.reason in ['inappropriate', 'wrong-age', 'confusing', 'other']
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 20
        && request.resource.data.platform in ['ios', 'android', 'web']
        && (request.resource.data.uid == null
            || (signedIn() && request.resource.data.uid == request.auth.uid))
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // ---------- usernames/{usernameLower}: uniqueness claims ----------
    match /usernames/{name} {
      // Signed-in users can check whether one name is taken, but can't list them.
      allow get: if signedIn();
      allow list: if false;

      // Claim a free name for yourself, in the same batch that sets it on your user doc.
      allow create: if signedIn()
        && name.matches('^[a-z0-9_.]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(userPath(request.auth.uid)).data.usernameLower == name;

      // Release your name when changing it or deleting your account (your user doc must
      // no longer use it, or no longer exist).
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && (!existsAfter(userPath(request.auth.uid))
            || getAfter(userPath(request.auth.uid)).data.usernameLower != name);

      allow update: if false;
    }
  }
}
