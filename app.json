{
  "expo": {
    "name": "What If?",
    "slug": "what-could-you-do",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.whatcouldyoudo.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.whatcouldyoudo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#49297e"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/graphics/splash-light.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#f9fafb",
          "dark": {
            "image": "./assets/graphics/splash-dark.png",
            "backgroundColor": "#0b0b0d"
          }
        }
      ],
      "expo-font"
    ],
    "newArchEnabled": true
  }
}
