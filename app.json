{
  "expo": {
    "name": "What If?",
    "slug": "what-could-you-do",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.whatcouldyoudo.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.whatcouldyoudo.app",
              "com.googleusercontent.apps.766575065414-gj38pdalkuo7s38uvbn0dvvoq6ulf9lq"
            ]
          }
        ]
      },
      "associatedDomains": [
        "applinks:what-if-dev-70316.firebaseapp.com"
      ]
    },
    "android": {
      "package": "com.whatcouldyoudo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#49297e"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/graphics/splash-light.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#f9fafb",
          "dark": {
            "image": "./assets/graphics/splash-dark.png",
            "backgroundColor": "#0b0b0d"
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.522009257826-35mkidjeff869h98vcq6ide1k6doifgn"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5b18bce3-d29c-49ff-9fff-2cd3bb7d3f2e"
      }
    },
    "owner": "castrovibes"
  }
}
