# Copy to .env (git-ignored). Expo exposes EXPO_PUBLIC_* variables to the app.
# For EAS builds, set the same names as EAS environment variables.

# Which account backend the app uses: "firebase" (default) or "mock" (on-device only,
# no emulator needed).
EXPO_PUBLIC_AUTH_BACKEND=firebase

# "true" in development: talk to the local Firebase emulators (`npm run emulators`)
# instead of a real project. Defaults to true in development builds when no real
# project is configured below.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true

# Real Firebase project (Project settings > Your apps > Web app config).
# Leave empty to use the emulator-only "demo-what-if" project.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Where sign-in email links point. Must be an authorized domain of the project and
# open the app (iOS Associated Domains). Defaults to https://<project>.firebaseapp.com/finishSignIn
EXPO_PUBLIC_EMAIL_LINK_URL=
