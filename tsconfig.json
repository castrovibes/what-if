{
  /**
   * TypeScript Configuration
   *
   * Configures the TypeScript compiler for type checking and transpilation.
   * Extends Expo's base TypeScript configuration with project-specific settings.
   *
   * @see https://www.typescriptlang.org/tsconfig
   * @see https://docs.expo.dev/guides/typescript/
   */

  // Inherit base configuration from Expo
  "extends": "expo/tsconfig.base",

  "compilerOptions": {
    // Enable all strict type-checking options for better code quality
    "strict": true,

    // Use React Native JSX factory (React.createElement)
    "jsx": "react-native",

    // Allow default imports from modules with no default export
    // Improves interoperability between CommonJS and ES modules
    "esModuleInterop": true,

    // Skip type checking of declaration files (.d.ts) for faster compilation
    // Useful when using third-party libraries with type issues
    "skipLibCheck": true,

    // Firebase Auth's React Native build exports getReactNativePersistence, but the
    // default (web) typings don't declare it; point TypeScript at the RN typings.
    "paths": {
      "@firebase/auth": ["./node_modules/@firebase/auth/dist/rn/index.rn.d.ts"]
    }
  }
}
