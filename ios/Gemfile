# Pins CocoaPods for local iOS builds so `pod install` behaves the same on every
# machine (EAS uses its own image). Run `bundle install && bundle exec pod install`.
source 'https://rubygems.org'

ruby '>= 2.6.10'

# Same constraints as the React Native template: 1.15.0/1.15.1 broke Xcode builds.
gem 'cocoapods', '>= 1.13', '!= 1.15.0', '!= 1.15.1'
gem 'activesupport', '>= 6.1.7.5', '!= 7.1.0'
# Needed by CocoaPods on Ruby 3.4+, where it's no longer a default gem.
gem 'bigdecimal'
gem 'concurrent-ruby', '< 1.3.4'
gem 'xcodeproj', '< 1.26.0'
